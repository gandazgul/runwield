<section class="owner-dashboard" data-owner-dashboard>
        <div class="owner-dashboard-intro">
            <p>Plans that need you, can continue, are running, or recently finished.</p>
            <a class="rw-toolbar-button" href="/projects">Projects</a>
        </div>
        <div class="owner-dashboard-status" role="status" aria-busy="true" data-dashboard-status>
            <span class="rw-thinking-dots" aria-label="Loading"><span aria-hidden="true">Loading</span><span class="rw-thinking-dot" aria-hidden="true"></span><span class="rw-thinking-dot" aria-hidden="true"></span><span class="rw-thinking-dot" aria-hidden="true"></span></span>
        </div>
        <div class="owner-dashboard-status" role="status" data-dashboard-warning hidden></div>
        <div class="owner-dashboard-grid" data-dashboard-sections></div>
    </section>
    <script is:inline data-astro-rerun>
(() => {
        const root = document.querySelector('[data-owner-dashboard]');
        const status = root?.querySelector('[data-dashboard-status]');
        const warning = root?.querySelector('[data-dashboard-warning]');
        const sectionsRoot = root?.querySelector('[data-dashboard-sections]');
        const labels = ['Needs You', 'Ready to Continue', 'In Progress', 'Recently Finished'];
        const sectionPreferences = new Map();
        let latestSections = [];
        let incomplete = false;
        let generation = 0;
        let dashboardRefreshInFlight = null;
        let dashboardRefreshTimer = null;
        function escapeText(value) {
            return String(value || '').replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[char]));
        }
        function timeHtml(value, label) {
            const timestamp = Date.parse(value);
            return Number.isFinite(timestamp)
                ? '<time datetime="' + escapeText(new Date(timestamp).toISOString()) + '">' + label + ' ' + escapeText(new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' }).format(timestamp)) + '</time>'
                : '';
        }
        function itemHtml(item) {
            const updated = timeHtml(item.updatedAt, 'Updated');
            const finished = timeHtml(item.recentAt, 'Finished');
            const dates = finished && item.recentAt === item.updatedAt ? finished : updated + (updated && finished ? ' · ' : '') + finished;
            return '<a class="owner-dashboard-row" href="' + escapeText(item.href) + '" title="' + escapeText(item.title) + '">' +
                '<span><strong>' + escapeText(item.title) + '</strong><small>' + escapeText(item.projectName) + ' · ' + escapeText(item.statusLabel) + '</small>' +
                (dates ? '<small class="owner-dashboard-row-time">' + dates + '</small>' : '') + '</span>' +
                '<span class="owner-dashboard-row-action">' + escapeText(item.actionLabel || 'View Plan') + '</span>' +
            '</a>';
        }
        function sectionHtml(section) {
            const preferences = sectionPreferences.get(section.label) || { oldestFirst: false, expanded: false };
            const items = Array.isArray(section.items) ? [...section.items] : [];
            if (preferences.oldestFirst) items.reverse();
            const visibleItems = preferences.expanded ? items : items.slice(0, 5);
            const id = 'dashboard-items-' + labels.indexOf(section.label);
            const sortLabel = preferences.oldestFirst ? 'Oldest update first' : 'Newest update first';
            const sortArrow = preferences.oldestFirst ? 'M18 20V4m-4 4 4-4 4 4' : 'M18 4v16m-4-4 4 4 4-4';
            return '<section class="owner-dashboard-section" aria-label="' + escapeText(section.label) + '">' +
                '<div class="owner-dashboard-section-heading"><h2>' + escapeText(section.label) + '</h2>' +
                '<span' + (incomplete ? ' title="Results incomplete" aria-label="At least ' + items.length + ' known items; some Projects could not be checked"' : '') + '>' + items.length + (incomplete ? '+' : '') + '</span>' + (items.length > 1 ? '<button class="rw-icon-button owner-dashboard-sort" type="button" data-dashboard-sort="' + escapeText(section.label) + '" aria-label="' + escapeText(section.label) + ': ' + sortLabel + '. Reverse sort" title="' + sortLabel + '" aria-pressed="' + preferences.oldestFirst + '"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h7M4 12h7M4 18h7"/><path d="' + sortArrow + '"/></svg></button>' : '') + '</div>' +
                '<div id="' + id + '">' + (items.length ? visibleItems.map(itemHtml).join('') : '<p class="empty">' + (incomplete ? 'No items found in checked Projects. Other items may be missing.' : 'Nothing here.') + '</p>') + '</div>' +
                (items.length > 5 ? '<button class="rw-toolbar-button" type="button" data-dashboard-expand="' + escapeText(section.label) + '" aria-controls="' + id + '" aria-expanded="' + preferences.expanded + '">' + (preferences.expanded ? 'Show less' : 'Read more (' + (items.length - 5) + ')') + '</button>' : '') +
            '</section>';
        }
        function renderSections() {
            const byLabel = new Map(latestSections.map((section) => [section.label, section]));
            const html = labels.map((label) => sectionHtml(byLabel.get(label) || { label, items: [] })).join('');
            if (sectionsRoot.innerHTML === html) return;
            const focused = document.activeElement;
            if (!sectionsRoot.contains(focused)) {
                sectionsRoot.innerHTML = html;
                return;
            }
            const sort = focused.getAttribute('data-dashboard-sort');
            const expand = focused.getAttribute('data-dashboard-expand');
            const row = focused.closest('.owner-dashboard-row');
            const sectionLabel = focused.closest('.owner-dashboard-section')?.getAttribute('aria-label');
            sectionsRoot.innerHTML = html;
            const attribute = sort ? 'data-dashboard-sort' : 'data-dashboard-expand';
            const control = (sort || expand) && [...sectionsRoot.querySelectorAll('button')].find((button) => button.getAttribute(attribute) === (sort || expand));
            const matchingRow = row && [...sectionsRoot.querySelectorAll('.owner-dashboard-row')].find((link) =>
                link.getAttribute('href') === row.getAttribute('href') && link.getAttribute('title') === row.getAttribute('title')
            );
            const section = [...sectionsRoot.querySelectorAll('.owner-dashboard-section')].find((node) => node.getAttribute('aria-label') === sectionLabel);
            const target = control || matchingRow || section?.querySelector('h2');
            if (target?.tagName === 'H2') target.tabIndex = -1;
            target?.focus({ preventScroll: true });
        }
        sectionsRoot.addEventListener('click', (event) => {
            const button = event.target.closest('button');
            if (!button) return;
            const label = button.dataset.dashboardSort || button.dataset.dashboardExpand;
            if (!labels.includes(label)) return;
            const preferences = sectionPreferences.get(label) || { oldestFirst: false, expanded: false };
            if (button.hasAttribute('data-dashboard-sort')) preferences.oldestFirst = !preferences.oldestFirst;
            else preferences.expanded = !preferences.expanded;
            sectionPreferences.set(label, preferences);
            renderSections();
        });
        async function refreshDashboard() {
            if (dashboardRefreshInFlight) return dashboardRefreshInFlight;
            const current = ++generation;
            dashboardRefreshInFlight = (async () => {
                try {
                    const response = await fetch('/api/owner/dashboard', { headers: { accept: 'application/json' } });
                    const payload = await response.json();
                    if (current !== generation) return;
                    if (!response.ok) throw new Error(payload.error || 'Dashboard failed to load.');
                    latestSections = Array.isArray(payload.dashboard?.sections) ? payload.dashboard.sections : [];
                    const unavailable = (payload.projects || []).filter((project) => project.lifecycle === 'enabled' && project.diagnostics?.length);
                    incomplete = unavailable.length > 0;
                    renderSections();
                    warning.hidden = unavailable.length === 0;
                    if (unavailable.length === 1) {
                        const project = unavailable[0];
                        warning.innerHTML = escapeText(project.displayName) + ' could not be fully checked. Dashboard items may be missing. <a href="' + escapeText(project.diagnostics[0].repairHref) + '">Open Project settings</a>.';
                    } else if (unavailable.length > 1) {
                        warning.innerHTML = unavailable.length + ' Projects could not be fully checked. Dashboard items may be missing. <a href="/projects">Open Projects</a>.';
                    } else {
                        warning.textContent = '';
                    }
                    status.hidden = true;
                    status.removeAttribute('aria-busy');
                } catch (error) {
                    if (current !== generation) return;
                    status.hidden = false;
                    status.removeAttribute('aria-busy');
                    status.setAttribute('role', 'alert');
                    status.textContent = error instanceof Error ? error.message : String(error);
                } finally {
                    dashboardRefreshInFlight = null;
                }
            })();
            return dashboardRefreshInFlight;
        }
        function startDashboardRefreshLoop() {
            if (dashboardRefreshTimer) return;
            refreshDashboard();
            dashboardRefreshTimer = setInterval(refreshDashboard, 5000);
        }
        function stopDashboardRefreshLoop() {
            if (!dashboardRefreshTimer) return;
            clearInterval(dashboardRefreshTimer);
            dashboardRefreshTimer = null;
        }
        startDashboardRefreshLoop();
        document.addEventListener('astro:before-preparation', stopDashboardRefreshLoop, { once: true });
        const onVisibilityChange = () => { if (document.visibilityState === 'visible') refreshDashboard(); };
        document.addEventListener('visibilitychange', onVisibilityChange);
        document.addEventListener('astro:before-swap', () => {
            ++generation;
            stopDashboardRefreshLoop();
            document.removeEventListener('visibilitychange', onVisibilityChange);
        }, { once: true });
    })();
</script>
