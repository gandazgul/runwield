---
import DashboardSection from "./DashboardSection.astro";
---
<section class="owner-dashboard" data-owner-dashboard>
    <div class="owner-dashboard-intro">
        <p>Plans that need you, can continue, are running, or recently finished.</p>
        <a class="rw-toolbar-button" href="/projects">Projects</a>
    </div>
    <div class="owner-dashboard-grid" data-dashboard-sections>
        <DashboardSection sectionKey="needs-you" label="Needs You" index={0} />
        <DashboardSection sectionKey="ready" label="Ready to Continue" index={1} />
        <DashboardSection sectionKey="in-progress" label="In Progress" index={2} />
        <DashboardSection sectionKey="recently-finished" label="Recently Finished" index={3} />
    </div>
    <p class="owner-dashboard-status" role="status" data-dashboard-warning hidden></p>
</section>
<script is:inline data-astro-rerun>
(() => {
    const root = document.querySelector('[data-owner-dashboard]');
    if (!root) return;
    const warning = root.querySelector('[data-dashboard-warning]');
    let settled = null;
    let current = null;
    let lastFrame = null;
    let pending = false;
    let failed = false;
    let requestId = 0;
    let timer = null;
    let controller = null;
    let destroyed = false;

    function render() {
        root.dispatchEvent(new CustomEvent('dashboard:update', { detail: { settled, current, lastFrame, pending, failed } }));
        const diagnostics = lastFrame?.diagnostics || [];
        warning.hidden = diagnostics.length === 0;
        if (diagnostics.length) warning.innerHTML = 'Some Project checks reported problems. Dashboard items may be missing. <a href="/projects">Open Projects</a>.';
    }
    root.addEventListener('dashboard:retry', () => refresh());
    function schedule() {
        clearTimeout(timer);
        if (!destroyed && document.visibilityState === 'visible') timer = setTimeout(refresh, 5000);
    }
    async function refresh() {
        if (destroyed || pending || document.visibilityState === 'hidden') return;
        const id = ++requestId;
        controller = new AbortController();
        current = null;
        lastFrame = null;
        pending = true;
        failed = false;
        clearTimeout(timer);
        render();
        let complete = false;
        try {
            const response = await fetch('/api/owner/dashboard/stream', { headers: { accept: 'application/x-ndjson' }, signal: controller.signal });
            if (!response.ok || !response.body) throw new Error('Dashboard failed to load.');
            const reader = response.body.getReader();
            const decoder = new TextDecoder();
            let buffer = '';
            const apply = (line) => {
                const frame = JSON.parse(line);
                if (id !== requestId || destroyed) return;
                if (frame.type === 'error') throw new Error(frame.error || 'Dashboard failed to load.');
                if (!Array.isArray(frame.sections) || !frame.progress) throw new Error('Invalid dashboard update.');
                current = frame;
                lastFrame = frame;
                if (frame.type === 'complete') { complete = true; pending = false; }
                render();
                if (complete) settled = { ...frame, sections: frame.sections.map((section) => {
                    if (!frame.sectionProgress?.[section.key]?.failed) return section;
                    const old = settled?.sections?.find((entry) => entry.key === section.key)?.items || [];
                    return { ...section, items: [...new Map([...old, ...section.items].map((item) => [item.type + ':' + item.projectId + ':' + item.href, item])).values()] };
                }) };
            };
            while (true) {
                const { done, value } = await reader.read();
                if (id !== requestId || destroyed) { await reader.cancel(); return; }
                if (done) break;
                buffer += decoder.decode(value, { stream: true });
                let end;
                while ((end = buffer.indexOf('\n')) !== -1) {
                    const line = buffer.slice(0, end);
                    buffer = buffer.slice(end + 1);
                    if (line.trim()) apply(line);
                }
            }
            buffer += decoder.decode();
            if (buffer.trim()) apply(buffer);
            if (!complete) throw new Error('Dashboard connection ended before results were checked.');
        } catch (error) {
            if (id !== requestId || destroyed) return;
            failed = true;
            pending = false;
            render();
        } finally {
            if (id === requestId && !destroyed) { pending = false; controller = null; schedule(); }
        }
    }
    function onVisibilityChange() {
        if (document.visibilityState === 'hidden') clearTimeout(timer);
        else if (!pending) refresh();
    }
    function stop() {
        destroyed = true;
        ++requestId;
        clearTimeout(timer);
        controller?.abort();
        document.removeEventListener('visibilitychange', onVisibilityChange);
    }
    document.addEventListener('visibilitychange', onVisibilityChange);
    document.addEventListener('astro:before-preparation', stop, { once: true });
    document.addEventListener('astro:before-swap', stop, { once: true });
    refresh();
})();
</script>
