---
import { ClientRouter } from "astro:transitions";
import { PLAN_SEARCH_QUERY_PARAM, PLAN_UI_TOKEN_QUERY } from "../constants.js";

const {
    title = "RunWield Workspace",
    selectedTab = "active",
    url = Astro.url.href,
    shell = "workspace",
    surfaceTitle = "",
} = Astro.props;
const currentUrl = url instanceof URL ? url : new URL(String(url));
const localShell = shell === "local";

function linkWithToken(path: string) {
    const ownerRoute = currentUrl.pathname === "/projects" || currentUrl.pathname.startsWith("/projects/") ||
        currentUrl.pathname === "/devices" || currentUrl.pathname === "/pair";
    const token = ownerRoute ? "" : currentUrl.searchParams.get(PLAN_UI_TOKEN_QUERY) || "";
    const query = currentUrl.searchParams.get(PLAN_SEARCH_QUERY_PARAM) || "";
    const next = new URL(path, currentUrl);
    if (token) next.searchParams.set(PLAN_UI_TOKEN_QUERY, token);
    if (query) next.searchParams.set(PLAN_SEARCH_QUERY_PARAM, query);
    return `${next.pathname}${next.search}`;
}
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="icon" href="/brand/logo.svg" type="image/svg+xml" />
        <link rel="stylesheet" href="/tokens.css" />
        <link rel="stylesheet" href="/components.css" />
        <link rel="stylesheet" href="/workspace.css" />
        <link rel="stylesheet" href="/theme.css" />
        {!localShell && <ClientRouter />}
        {!localShell && (
            <script>
                import { navigate } from "astro:transitions/client";
                Reflect.set(globalThis, "__runwieldWorkspaceNavigate", navigate);
            </script>
        )}
    </head>
    <body class="theme-runwield">
        {localShell ? (
            <div class="workspace-shell workspace-local-shell" data-selected-tab={selectedTab} data-astro-workspace-shell>
                <header class="workspace-local-header">
                    <a class="brand" href={linkWithToken("/")} aria-label="RunWield Plans home">
                        <img class="brand-logo" src="/brand/logo.svg" alt="" aria-hidden="true" />
                        <span>RunWield Plans</span>
                    </a>
                    <div class="tab-search-slot" data-plan-search-slot>
                        <slot name="toolbar" />
                    </div>
                </header>
                <main>
                    <slot />
                </main>
            </div>
        ) : (
            <div class="workspace-shell workspace-shell-with-sidebar" data-selected-tab={selectedTab} data-astro-workspace-shell>
                <aside class="workspace-sidebar" data-workspace-sidebar aria-label="Workspace navigation" transition:name="workspace-sidebar" transition:persist>
                    <div class="workspace-sidebar-brand">
                        <a href={linkWithToken("/")} aria-label="RunWield Workspace home">
                            <img src="/brand/logo.svg" alt="" aria-hidden="true" />
                            <span>RunWield</span>
                        </a>
                    </div>
                    <p class="workspace-sidebar-empty">Loading Workspace…</p>
                </aside>
                <div class="workspace-main-shell">
                    <header class:list={["workspace-main-header", surfaceTitle && "workspace-main-surface-header"]}>
                        <div class="workspace-main-header-left" data-workspace-main-header-left>
                            {surfaceTitle ? (
                                <strong class="workspace-main-session-name" data-workspace-surface-title>{surfaceTitle}</strong>
                            ) : (
                                <a class="brand workspace-main-brand" href={linkWithToken("/")} aria-label="RunWield Workspace home">
                                    <img class="brand-logo" src="/brand/logo.svg" alt="" aria-hidden="true" />
                                    <span>RunWield Workspace</span>
                                </a>
                            )}
                        </div>
                        <div class="tab-search-slot" data-plan-search-slot>
                            <slot name="toolbar" />
                        </div>
                        <div class="workspace-main-header-actions" data-workspace-header-actions></div>
                    </header>
                    <main>
                        <slot />
                    </main>
                </div>
            </div>
        )}
        {!localShell && <script is:inline type="module" src="/workspace-shell.js"></script>}
    </body>
</html>
