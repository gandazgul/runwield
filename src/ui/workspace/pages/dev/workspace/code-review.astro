---
import LoadingSurface from "../../../components/LoadingSurface.astro";
import WorkspaceLayout from "../../../layouts/WorkspaceLayout.astro";
import { ReviewDevSurface } from "../../../react/ReviewDevSurface.tsx";

if (!import.meta.env.DEV) {
    return new Response("Not found", { status: 404 });
}
---
<WorkspaceLayout surfaceTitle="Code Review" title="Workspace Code Review Dev · RunWield" selectedTab="projects" url={Astro.url.href}>
    <ReviewDevSurface surface="code" presentation="workspace" client:only="react">
        <div slot="fallback"><LoadingSurface label="Loading review" /></div>
    </ReviewDevSurface>
</WorkspaceLayout>
