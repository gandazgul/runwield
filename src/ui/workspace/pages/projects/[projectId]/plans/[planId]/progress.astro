---
import WorkspaceLayout from "../../../../../layouts/WorkspaceLayout.astro";
import { PlanProgressSurface } from "../../../../../react/PlanProgressSurface.tsx";
import { serializeCanonicalPlanError } from "../../../../../server/astro-canonical-data.js";
import { loadOwnerProjectPlanProgress } from "../../../../../server/astro-owner-data.js";

const projectId = Astro.params.projectId ?? "";
const planId = Astro.params.planId ?? "";
const runwieldSessionId = Astro.url.searchParams.get("session") || "";
let progress = null;
let error = null;
try {
    progress = await loadOwnerProjectPlanProgress(projectId, planId, runwieldSessionId || null);
} catch (caught) {
    error = await serializeCanonicalPlanError(caught);
    Astro.response.status = error.error.includes("not found") || error.error.includes("Plan not found") ? 404 : 409;
}
const apiUrl = `/api/owner/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}/progress${
    runwieldSessionId ? `?session=${encodeURIComponent(runwieldSessionId)}` : ""
}`;
const progressUrl = `/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}/progress${
    runwieldSessionId ? `?session=${encodeURIComponent(runwieldSessionId)}` : ""
}`;
---
<WorkspaceLayout
    title={progress ? `${progress.plan.title} progress · RunWield Workspace` : "Plan progress · RunWield Workspace"}
    selectedTab="projects"
    url={Astro.url.href}
>
    {error ? (
        <section class="error-panel">
            <h2>Plan progress lookup failed</h2>
            <p>{error.error}</p>
            <p>{error.repair}</p>
        </section>
    ) : (
        <PlanProgressSurface initialProgress={progress} apiUrl={apiUrl} progressUrl={progressUrl} client:only="react" />
    )}
</WorkspaceLayout>
