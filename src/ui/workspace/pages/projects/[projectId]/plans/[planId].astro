---
import WorkspaceLayout from "../../../../layouts/WorkspaceLayout.astro";
import { PlanDetail } from "../../../../components/PlanDetail.jsx";
import { PlanReviewSurface } from "../../../../react/PlanReviewSurface.tsx";
import { PlanHomeSurface } from "../../../../react/PlanHomeSurface.tsx";
import { serializeCanonicalPlanError } from "../../../../server/astro-canonical-data.js";
import {
    getAstroOwnerWorkspaceSessionContinuation,
    getAstroOwnerWorkspaceStore,
    loadOwnerProjectPlanDetail,
} from "../../../../server/astro-owner-data.js";
import { loadOwnerPlanProgress } from "../../../../server/owner-plan-progress.ts";

const projectId = Astro.params.projectId ?? "";
const planId = Astro.params.planId ?? "";
const runwieldSessionId = Astro.url.searchParams.get("session") || "";
const operationId = Astro.url.searchParams.get("operation") || "";
const interactionId = Astro.url.searchParams.get("interaction") || "";
let liveReview = null;
let plan = null;
let progress = null;
let error = null;
let recoveryGeneration = null;
let recoveryCurrentSegmentId = null;
try {
    plan = await loadOwnerProjectPlanDetail(projectId, planId);
    const store = getAstroOwnerWorkspaceStore();
    if (store && plan && !plan.isEpic && plan.classification !== "PROJECT") {
        progress = await loadOwnerPlanProgress(store, { projectId, planId, runwieldSessionId });
    }
    if (runwieldSessionId && operationId && interactionId) {
        liveReview = await getAstroOwnerWorkspaceSessionContinuation()?.getLivePlanReview?.({
            projectId,
            planId,
            runwieldSessionId,
            operationId,
            interactionId,
        }) || null;
        const inspected = getAstroOwnerWorkspaceStore()?.inspectSessionActivation?.(runwieldSessionId);
        recoveryGeneration = inspected?.generation?.generation ?? null;
        recoveryCurrentSegmentId = inspected?.generation?.currentSegmentId ?? null;
    }
} catch (caught) {
    error = await serializeCanonicalPlanError(caught);
    Astro.response.status = error.error.includes("not found") || error.error.includes("Plan not found") ? 404 : 409;
}
const fromDashboard = Astro.url.searchParams.get("from") === "dashboard";
const sessionId = progress?.session?.runwieldSessionId || runwieldSessionId;
const planHomePayload = plan && !plan.isEpic && plan.classification !== "PROJECT"
    ? {
        mode: "workspace",
        planId,
        planName: plan.planName,
        title: plan.title || plan.planName || planId,
        status: plan.status || plan.attrs?.status,
        classification: plan.classification || plan.attrs?.classification,
        parentPlan: plan.parentPlan || plan.attrs?.parentPlan,
        artifactPath: plan.path,
        markdown: plan.markdown || plan.body || "",
        returnHref: fromDashboard ? "/" : `/projects/${encodeURIComponent(projectId)}/plans`,
        returnLabel: fromDashboard ? "Back to Dashboard" : "Back to Plans",
        planHref: `/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}`,
        sessionHref: sessionId
            ? `/projects/${encodeURIComponent(projectId)}/sessions/${encodeURIComponent(sessionId)}`
            : "",
        workflow: {
            sessionState: typeof progress?.session?.state === "string" ? progress.session.state : "",
            degradedMessage: typeof progress?.degraded?.message === "string" ? progress.degraded.message : "",
            stages: Array.isArray(progress?.stages) ? progress.stages : [],
        },
    }
    : null;
const reviewPayload = plan && liveReview
    ? {
        mode: "workspace",
        sequenceDocuments: liveReview.request?.planReview?.sequenceDocuments,
        plan: plan.markdown || plan.body || "",
        previousPlan: liveReview.request?.planReview?.previousPlan || undefined,
        planVersions: liveReview.request?.planReview?.planVersions || undefined,
        projectId,
        planPath: plan.path,
        classification: liveReview.request?.planReview?.classification,
        agentLabel: liveReview.request?.planReview?.agentLabel || "Planner",
        runwieldSessionId,
        reviewContext: {
            projectLabel: projectId,
            sessionHref: `/projects/${encodeURIComponent(projectId)}/sessions/${
                encodeURIComponent(runwieldSessionId)
            }`,
            sessionLabel: runwieldSessionId,
            actingSession: runwieldSessionId,
            planLabel: plan.title || plan.planName || planId,
            planStatus: plan.status || plan.attrs?.status,
            live: true,
        },
        interactionAnswerUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/session-operations/${
            encodeURIComponent(operationId)
        }/interactions/${encodeURIComponent(interactionId)}/answer`,
        interactionAnswerBaseUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/session-operations/${
            encodeURIComponent(operationId)
        }/interactions`,
        interactionId,
        operationStatusUrl: `/api/owner/session-operations/${encodeURIComponent(operationId)}`,
        planDetailUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}`,
        recoveryUrl: `/api/owner/projects/${encodeURIComponent(projectId)}/sessions/${
            encodeURIComponent(runwieldSessionId)
        }/force-recovery`,
        recoveryExpectedGeneration: recoveryGeneration,
        recoveryExpectedCurrentSegmentId: recoveryCurrentSegmentId,
        progressUrl: `/projects/${encodeURIComponent(projectId)}/plans/${encodeURIComponent(planId)}?session=${
            encodeURIComponent(runwieldSessionId)
        }`,
    }
    : null;
---
<WorkspaceLayout
    title={plan ? `${plan.planName} · RunWield Workspace` : "Project Plan · RunWield Workspace"}
    surfaceTitle={reviewPayload ? `Plan Review — ${plan.title || plan.planName || planId}` : ""}
    selectedTab="projects"
    url={Astro.url.href}
>
    {error ? (
        <section class="error-panel">
            <h2>Project Plan lookup failed</h2>
            <p>{error.error}</p>
            <p>{error.repair}</p>
        </section>
    ) : reviewPayload ? (
        <PlanReviewSurface payload={reviewPayload} presentation="workspace" client:only="react" />
    ) : planHomePayload ? (
        <PlanHomeSurface payload={planHomePayload} presentation="workspace" client:only="react" />
    ) : (
        <PlanDetail
            plan={plan}
            url={Astro.url.href}
            editIntent={false}
            progress={progress}
            projectId={projectId}
            runwieldSessionId={runwieldSessionId}
            client:load
        />
    )}
</WorkspaceLayout>
