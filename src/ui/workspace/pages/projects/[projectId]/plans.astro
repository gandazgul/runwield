---
import WorkspaceLayout from "../../../layouts/WorkspaceLayout.astro";
import { PlanBoard } from "../../../components/Board.jsx";
import { serializeCanonicalPlanError } from "../../../server/astro-canonical-data.js";
import { loadOwnerProjectBoard, loadOwnerProjects } from "../../../server/astro-owner-data.js";

const projectId = Astro.params.projectId ?? "";
const project = (await loadOwnerProjects()).find((item: { projectId: string }) => item.projectId === projectId);
let board = null;
let error = null;
try {
    board = await loadOwnerProjectBoard(projectId);
} catch (caught) {
    error = await serializeCanonicalPlanError(caught);
    Astro.response.status = 409;
}
---
<WorkspaceLayout title="Project Plan Board" selectedTab="projects" url={Astro.url.href}>
    <section class="page-header">
        <h1>{project ? `${project.displayName} Plan Board` : "Project Plan Board"}</h1>
        <p>{project ? `${project.rootLabel} · ${project.healthStatus}` : "Owner Workspace shows registered Project Plans within their Project boundary."}</p>
    </section>
    {error ? (
        <section class="error-panel">
            <h2>Project Plan Board failed to load</h2>
            <p>{error.error}</p>
        </section>
    ) : (
        <PlanBoard board={board} view="active" url={Astro.url.href} client:load />
    )}
</WorkspaceLayout>
