---
import WorkspaceLayout from "../../layouts/WorkspaceLayout.astro";
import { loadOwnerProjects } from "../../server/astro-owner-data.js";

const projects = await loadOwnerProjects();
---
<WorkspaceLayout title="Projects · RunWield Workspace" selectedTab="projects" url={Astro.url.href}>
    <section class="page-header">
        <h1>Projects</h1>
        <p>Link a Project, then open its Sessions.</p>
    </section>
    <section class="owner-card project-link-card">
        <h2>Link a Project</h2>
        <form class="owner-form project-register-form" data-project-register>
            <label>Project root <input name="root" required placeholder="Absolute path to a Project" /></label>
            <label>Display name <input name="displayName" placeholder="Optional" /></label>
            <button class="primary-action" type="submit">Link Project</button>
        </form>
        <p class="muted" data-project-register-status role="status"></p>
    </section>
    <section class="project-list-panel" aria-label="Linked Projects">
        {projects.length ? projects.map((project: { projectId: string; displayName: string; rootLabel: string; healthStatus: string; lifecycle: string; enabled: boolean }) => (
            <a
                class="project-list-row"
                href={project.enabled
                    ? `/projects/${encodeURIComponent(project.projectId)}/sessions`
                    : `/projects/${encodeURIComponent(project.projectId)}/settings`}
            >
                <span>
                    <strong>{project.displayName}</strong>
                    <small>{project.rootLabel} · {project.healthStatus}</small>
                </span>
                <span class="project-list-state">{project.lifecycle}{project.enabled ? "" : " · unavailable"}</span>
            </a>
        )) : (
            <p class="empty">No Projects are linked yet.</p>
        )}
    </section>
    <script is:inline>
        function ownerCookie(name){return document.cookie.split('; ').find(v=>v.startsWith(name+'='))?.split('=').slice(1).join('=')||'';}
        async function ownerFetch(url,options={}){options.headers=Object.assign({'content-type':'application/json','x-runwield-csrf':decodeURIComponent(ownerCookie('rw_owner_csrf'))},options.headers||{});return await fetch(url,options);}
        const registerForm=document.querySelector('[data-project-register]');
        const status=document.querySelector('[data-project-register-status]');
        registerForm?.addEventListener('submit',async(event)=>{event.preventDefault();const formData=new FormData(registerForm);if(status)status.textContent='Linking Project...';const response=await ownerFetch('/api/owner/projects',{method:'POST',body:JSON.stringify({root:formData.get('root'),displayName:formData.get('displayName')})});const data=await response.json().catch(()=>({}));if(response.ok&&data.project?.projectId){location.href='/projects/'+encodeURIComponent(data.project.projectId)+'/sessions';return;}if(status)status.textContent=data.error||'Project link failed.';});
    </script>
</WorkspaceLayout>
