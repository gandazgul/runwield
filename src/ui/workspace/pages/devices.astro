---
import SettingsLayout from "../layouts/SettingsLayout.astro";
import { DeviceList } from "../react/DeviceList.tsx";
---
<SettingsLayout title="Devices · RunWield Workspace" active="devices">
    <div class="workspace-settings-intro">
        <h1>Paired devices</h1>
        <p>Devices have access across your Workspace. Revoking access does not stop running workflows.</p>
    </div>
    <DeviceList client:load />
</SettingsLayout>
