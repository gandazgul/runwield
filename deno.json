        "react": "npm:react@^19.2.7",
        "react-dom": "npm:react-dom@^19.2.7",
        "react-dom/client": "npm:react-dom@^19.2.7/client",
        "@types/react": "npm:@types/react@^19.2.18",
        "@types/react-dom": "npm:@types/react-dom@^19.2.3",
        "@base-ui/react/": "npm:@base-ui/react@^1.7.0/",
        "@zag-js/dialog": "npm:@zag-js/dialog@^1.42.0",
        "@zag-js/preact": "npm:@zag-js/preact@^1.43.0",
        "vite": "npm:vite@^8.1.5",
        "esbuild": "npm:esbuild@^0.28.2",
