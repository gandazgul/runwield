        "@codemirror/lang-markdown": "npm:@codemirror/lang-markdown@^6.5.0",
        "@codemirror/lang-javascript": "npm:@codemirror/lang-javascript@^6.2.5",
        "@codemirror/lang-json": "npm:@codemirror/lang-json@^6.0.2",
        "@codemirror/lang-python": "npm:@codemirror/lang-python@^6.2.1",
        "@codemirror/lang-yaml": "npm:@codemirror/lang-yaml@^6.1.3",
        "@codemirror/language": "npm:@codemirror/language@^6.12.4",
        "@codemirror/legacy-modes": "npm:@codemirror/legacy-modes@^6.5.3",
        "@codemirror/state": "npm:@codemirror/state@^6.7.1",
        "@codemirror/view": "npm:@codemirror/view@^6.43.6",
        "@lezer/common": "npm:@lezer/common@^1.5.2",
        "@lezer/highlight": "npm:@lezer/highlight@^1.2.3",
        "@pierre/diffs/worker/worker.js": "./src/ui/workspace/react/pierre-diffs-worker-shim.js",
        "@pierre/diffs/edit": "npm:@pierre/diffs@1.3.5/edit",
        "@pierre/diffs/react": "npm:@pierre/diffs@1.3.5/react",
        "@pierre/diffs": "npm:@pierre/diffs@1.3.5",
        "@radix-ui/react-checkbox": "npm:@radix-ui/react-checkbox@^1.3.11",
        "@radix-ui/react-collapsible": "npm:@radix-ui/react-collapsible@^1.1.20",
        "@radix-ui/react-context-menu": "npm:@radix-ui/react-context-menu@^2.3.3",
        "@radix-ui/react-dialog": "npm:@radix-ui/react-dialog@^1.1.19",
        "@radix-ui/react-dropdown-menu": "npm:@radix-ui/react-dropdown-menu@^2.1.24",
        "@radix-ui/react-popover": "npm:@radix-ui/react-popover@^1.1.19",
        "@radix-ui/react-slot": "npm:@radix-ui/react-slot@^1.3.3",
        "@radix-ui/react-tabs": "npm:@radix-ui/react-tabs@^1.1.21",
        "@radix-ui/react-tooltip": "npm:@radix-ui/react-tooltip@^1.2.12",
        "@tanstack/react-table": "npm:@tanstack/react-table@^8.21.3",
        "@viz-js/viz": "npm:@viz-js/viz@^3.29.0",
        "class-variance-authority": "npm:class-variance-authority@^0.7.1",
        "clsx": "npm:clsx@^2.1.1",
        "diff": "npm:diff@^9.0.0",
        "dompurify": "npm:dompurify@^3.4.11",
        "highlight.js": "npm:highlight.js@^11.11.1",
        "beautiful-mermaid": "npm:beautiful-mermaid@^1.1.3",
        "katex": "npm:katex@^0.18.2",
        "lucide-react": "npm:lucide-react@^1.25.0",
        "marked": "npm:marked@^17.0.6",
        "mermaid": "npm:mermaid@^11.16.0",
        "motion": "npm:motion@^12.42.2",
        "tailwind-merge": "npm:tailwind-merge@^3.6.0",
        "unique-username-generator": "npm:unique-username-generator@^1.5.1",
        "fuse.js": "npm:fuse.js@^7.4.2",
        "perfect-freehand": "npm:perfect-freehand@^1.2.3",
        "@deno/astro-adapter": "npm:@deno/astro-adapter@^0.6.0",
        "@astrojs/react": "npm:@astrojs/react@^6.0.1",
        "@astrojs/check": "npm:@astrojs/check@^0.9.9",
        "astro": "npm:astro@^7.1.3",
        "typescript": "npm:typescript@^5.9.3",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.0.5",
        "react/jsx-runtime": "npm:react@^19.2.7/jsx-runtime",
        "react/jsx-dev-runtime": "npm:react@^19.2.7/jsx-dev-runtime",
        "@xterm/headless": "npm:@xterm/headless@5.5.0"
    },
    "tasks": {
        "ci": "deno run -A scripts/run-ci.ts",
        "cli": "deno run -A --unstable-no-legacy-abort src/cli.ts",
        "submodules:check": "deno run -A scripts/check-submodules.js",
        "submodules:check:remote": "deno run -A scripts/check-submodule-fetchability.js",
        "snip:check": "deno run -A scripts/check-snip-filters.ts",
        "language-policy:check": "deno run -A scripts/check-language-policy.js",
        "seams:check": "deno run -A scripts/check-injection-seams.js",
        "doc-links:check": "deno run -A scripts/check-doc-links.js",
        "seams:update": "deno run -A scripts/check-injection-seams.js --update",
        "test": "deno run -A scripts/write-version.js && deno run -A scripts/run-tests.js",
        "lint": "deno run -A scripts/run-with-snip.ts lint -- deno lint",
        "githooks:install": "git config core.hooksPath .githooks",
        "githooks:uninstall": "git config --unset core.hooksPath",
        "check": "deno run -A scripts/write-version.js && deno run -A scripts/check-types.js",
        "workspace:dev": "deno run -A --env npm:astro dev --config src/ui/workspace/astro.config.mjs --host 127.0.0.1 --port 5173",
        "workspace:remote": "deno run -A src/ui/workspace/remote-server.ts",
        "workspace:remote:build": "deno task workspace:build && deno run -A scripts/build-workspace-runtime.js && deno run -A scripts/build-plan-server-runtime.js",
        "workspace:remote:image:check": "deno run -A scripts/assert-plan-server-image.js",
        "workspace:react:check": "deno task workspace:check",
        "workspace:test": "deno run -A scripts/run-tests.js -A --parallel --no-check src/ui/workspace src/cmd/plans/ui.test.ts",
        "workspace:dev:plan-review": "deno run -A --env npm:astro dev --config src/ui/workspace/astro.config.mjs --host 127.0.0.1 --port 5173 --open /dev/plan-review",
        "workspace:dev:code-review": "deno run -A --env npm:astro dev --config src/ui/workspace/astro.config.mjs --host 127.0.0.1 --port 5173 --open /dev/code-review",
        "workspace:build": "deno run -A --env npm:astro build --config src/ui/workspace/astro.config.mjs",
        "workspace:check": "deno run -A npm:astro check --root src/ui/workspace --tsconfig tsconfig.json",
        "compile": "deno run -A ./scripts/compile.js",
        "ux:new-user": "podman build --target wld-ux-latest --build-arg WLD_INSTALL_REFRESH=$(date +%s) -f Containerfile.wld-ux -t runwield-wld-ux:local . && podman run --rm -it -e ANTHROPIC_API_KEY -e OPENAI_API_KEY -e GOOGLE_API_KEY -e MISTRAL_API_KEY runwield-wld-ux:local",
        "ux:new-user:current": "sh -c 'case $(uname -m) in arm64|aarch64) target=aarch64-unknown-linux-gnu ;; x86_64|amd64) target=x86_64-unknown-linux-gnu ;; *) echo unsupported container compile architecture: $(uname -m) >&2; exit 1 ;; esac; deno task compile --target \"$target\" && podman build --target wld-ux-current --build-arg WLD_INSTALL_REFRESH=$(date +%s) -f Containerfile.wld-ux -t runwield-wld-ux-current:local . && podman run --rm -it -e ANTHROPIC_API_KEY -e OPENAI_API_KEY -e GOOGLE_API_KEY -e MISTRAL_API_KEY runwield-wld-ux-current:local'",
        "release:check": "deno run -A scripts/release-check.js",
        "release:metadata": "deno run -A scripts/release.js metadata",
        "release:candidate": "deno run -A scripts/release.js candidate",
        "release:promote": "deno run -A scripts/release.js promote",
        "release:stable": "deno run -A scripts/release.js stable",
        "compile:watch": "watchexec -e js,jsx,mjs,md,css,ts,tsx,json --ignore node_modules --ignore dist --ignore bin --ignore src/shared/version.js -- deno task compile",
        "prototype": "deno run -A scripts/run-prototype.js",
        "test:golden-tui": "deno run -A scripts/write-version.js && deno run -A scripts/run-tests.js --isolated src/ui/tui/testing src/ui/tui/golden-scenarios",
        "test:golden-tui:extensive": "deno run -A scripts/write-version.js && deno run -A scripts/run-tests.js --isolated src/ui/tui/testing src/ui/tui/golden-scenarios"
    },
    "lint": {
        "plugins": [
            "./scripts/lint-rules/no-module-scope-process-state.js"
        ]
    },
    "fmt": {
        "lineWidth": 120,
        "indentWidth": 4
    },
    "exclude": [
        "node_modules",
        ".idea",
        ".history",
        "third_party",
        "_fresh",
        ".astro",
        "dist",
        "src/ui/workspace/node_modules",
        "src/ui/workspace/.astro",
        "compiled-review-*.tmp.js"
    ]
}
